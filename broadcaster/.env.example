# ===== Telegram =====
# Токен от @BotFather и ваш Telegram ID (узнать: @userinfobot), можно несколько через запятую
TG_TOKEN=
TG_ADMIN_IDS=

# ===== MAX =====
# Токен бота (business.max.ru → Чат-боты → Интеграция). Бота может создать только организация (ИП/юрлицо).
MAX_TOKEN=
MAX_BOT_LINK=https://max.ru/имя_вашего_бота
# Если Python не доверяет сертификату MAX (сертификаты Минцифры) — укажите путь к russian_trusted_root_ca.pem
MAX_CA_BUNDLE=

# ===== E-mail: рабочий ящик =====
# Параметры SMTP спросите у IT. Частые варианты:
#   Яндекс 360:        smtp.yandex.ru, 465, ssl (нужен пароль приложения)
#   Mail.ru для бизнеса: smtp.mail.ru, 465, ssl (пароль для внешних приложений)
#   Microsoft Exchange: адрес вашего сервера, 587, starttls (должен быть разрешён SMTP AUTH)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USER=ivanov@cifra-broker.ru
SMTP_PASSWORD=
EMAIL_FROM=ivanov@cifra-broker.ru
EMAIL_FROM_NAME=Иван Иванов, Цифра брокер
# Подпись под письмом (\n — перенос строки)
EMAIL_SIGNATURE=С уважением,\nИван Иванов\n+7 900 000-00-00
# Пауза между письмами (сек) и дневной лимит — чтобы почтовый сервер не счёл рассылку спамом
EMAIL_DELAY=4
EMAIL_DAILY_LIMIT=300

# ===== Общее =====
DISCLAIMER=Информация не является индивидуальной инвестиционной рекомендацией.
# Веб-панель: логин/пароль обязательны, иначе панель не запустится
WEB_USER=admin
WEB_PASSWORD=
WEB_HOST=127.0.0.1
WEB_PORT=8080
# Публичный адрес панели (https://...) — нужен для ссылки «Отписаться» в письмах
PUBLIC_URL=
DB_PATH=broadcaster.db
